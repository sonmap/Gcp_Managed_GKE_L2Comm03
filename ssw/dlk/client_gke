#!/usr/bin/env bash
set -euo pipefail

# L2Comm03 - GKE Autopilot common client
# - Uses the private GKE kubeconfig on infra-son01
# - Creates/reuses a static NFS PV/PVC
# - Creates a batch Pod and mounts the Git-managed NFS share read-only

export KUBECONFIG="${KUBECONFIG:-$HOME/.kube/config_new-autopilot}"

PROGRAM_ID=""
DOCKER_IMAGE=""
GPU="0"
CPU="1"
MEM_GB="4"
SHELL_COMMAND=""
NAMESPACE="l2comm-batch"
KSA_NAME="ksa-l2comm-batch"
RUNTIME_GSA="sa-l2comm-gke@gcp-prod-edp-edge-509423.iam.gserviceaccount.com"

# By default the current VM is used as the PoC NFS server.
NFS_SERVER="${NFS_SERVER:-$(hostname -I 2>/dev/null | awk '{print $1}')}"
NFS_PATH="${NFS_PATH:-/}"
PV_NAME="${PV_NAME:-l2comm-git-nfs-pv}"
PVC_NAME="${PVC_NAME:-l2comm-git-nfs-pvc}"
POD_MOUNT_PATH="${POD_MOUNT_PATH:-/mnt/l2comm}"
PV_SIZE="${PV_SIZE:-20Gi}"

usage() {
  cat <<'USAGE'
Usage:
  client_gke \
    --program-id PROGRAM_ID \
    --docker-image IMAGE_URI \
    --gpu 0 \
    --cpu 4 \
    --mem-gb 16 \
    --shell-command "cd /mnt/l2comm/python && python bq_sample.py" \
    [--namespace l2comm-batch] \
    [--nfs-server 172.x.x.x] \
    [--nfs-path /]

Environment:
  KUBECONFIG     default: $HOME/.kube/config_new-autopilot
  DRY_RUN=1      create/print manifests only; do not kubectl apply
  PV_NAME        default: l2comm-git-nfs-pv
  PVC_NAME       default: l2comm-git-nfs-pvc
  POD_MOUNT_PATH default: /mnt/l2comm
  PV_SIZE        default: 20Gi
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --program-id) PROGRAM_ID="$2"; shift 2 ;;
    --docker-image) DOCKER_IMAGE="$2"; shift 2 ;;
    --gpu) GPU="$2"; shift 2 ;;
    --cpu) CPU="$2"; shift 2 ;;
    --mem-gb) MEM_GB="$2"; shift 2 ;;
    --shell-command) SHELL_COMMAND="$2"; shift 2 ;;
    --namespace) NAMESPACE="$2"; shift 2 ;;
    --nfs-server) NFS_SERVER="$2"; shift 2 ;;
    --nfs-path) NFS_PATH="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "ERROR: unknown option: $1" >&2; usage; exit 1 ;;
  esac
done

[[ -n "$PROGRAM_ID" ]] || { echo "ERROR: --program-id is required" >&2; exit 1; }
[[ -n "$DOCKER_IMAGE" ]] || { echo "ERROR: --docker-image is required" >&2; exit 1; }
[[ -n "$SHELL_COMMAND" ]] || { echo "ERROR: --shell-command is required" >&2; exit 1; }
[[ -n "$NFS_SERVER" ]] || { echo "ERROR: NFS server IP could not be detected. Use --nfs-server." >&2; exit 1; }

POD_BASE="$(echo "$PROGRAM_ID" | tr '[:upper:]' '[:lower:]' | tr '_. ' '---' | tr -cd 'a-z0-9-')"
POD_BASE="${POD_BASE:0:40}"
POD_NAME="${POD_BASE}-$(date +%Y%m%d%H%M%S)"
TMP_DIR="/tmp/${POD_NAME}"
PV_YAML="${TMP_DIR}/pv.yaml"
PVC_YAML="${TMP_DIR}/pvc.yaml"
POD_YAML="${TMP_DIR}/pod.yaml"
mkdir -p "$TMP_DIR"

cat > "$PV_YAML" <<YAML
apiVersion: v1
kind: PersistentVolume
metadata:
  name: ${PV_NAME}
spec:
  capacity:
    storage: ${PV_SIZE}
  accessModes:
    - ReadOnlyMany
  persistentVolumeReclaimPolicy: Retain
  storageClassName: ""
  mountOptions:
    - vers=4.1
  nfs:
    server: ${NFS_SERVER}
    path: ${NFS_PATH}
    readOnly: true
YAML

cat > "$PVC_YAML" <<YAML
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: ${PVC_NAME}
  namespace: ${NAMESPACE}
spec:
  accessModes:
    - ReadOnlyMany
  storageClassName: ""
  volumeName: ${PV_NAME}
  resources:
    requests:
      storage: ${PV_SIZE}
YAML

cat > "$POD_YAML" <<YAML
apiVersion: v1
kind: Pod
metadata:
  name: ${POD_NAME}
  namespace: ${NAMESPACE}
  labels:
    app: l2comm-batch
    program-id: ${POD_BASE}
spec:
  restartPolicy: Never
  serviceAccountName: ${KSA_NAME}
  containers:
    - name: batch
      image: ${DOCKER_IMAGE}
      imagePullPolicy: IfNotPresent
      command: ["/bin/bash", "-c"]
      args:
        - |
          set -e
          ${SHELL_COMMAND}
      resources:
        requests:
          cpu: "${CPU}"
          memory: "${MEM_GB}Gi"
        limits:
          cpu: "${CPU}"
          memory: "${MEM_GB}Gi"
      volumeMounts:
        - name: git-nfs
          mountPath: ${POD_MOUNT_PATH}
          readOnly: true
  volumes:
    - name: git-nfs
      persistentVolumeClaim:
        claimName: ${PVC_NAME}
YAML

if [[ "$GPU" != "0" ]]; then
  python3 - "$POD_YAML" "$GPU" <<'PY'
import sys
from pathlib import Path

path = Path(sys.argv[1])
gpu = sys.argv[2]
text = path.read_text()
needle = '''        limits:
          cpu: "'''
replacement = '''        limits:
          nvidia.com/gpu: "''' + gpu + '''"
          cpu: "'''
if needle not in text:
    raise SystemExit("GPU insertion point not found")
path.write_text(text.replace(needle, replacement, 1))
PY
fi

echo "============================================================"
echo "L2Comm03 GKE batch"
echo "============================================================"
echo "KUBECONFIG    : $KUBECONFIG"
echo "NAMESPACE     : $NAMESPACE"
echo "PROGRAM_ID    : $PROGRAM_ID"
echo "POD_NAME      : $POD_NAME"
echo "IMAGE         : $DOCKER_IMAGE"
echo "CPU/MEM/GPU   : $CPU / ${MEM_GB}Gi / $GPU"
echo "NFS_SERVER    : $NFS_SERVER"
echo "NFS_PATH      : $NFS_PATH"
echo "PV/PVC        : $PV_NAME / $PVC_NAME"
echo "POD_MOUNT     : $POD_MOUNT_PATH"
echo "COMMAND       : $SHELL_COMMAND"
echo "MANIFEST_DIR  : $TMP_DIR"
echo "============================================================"

if [[ "${DRY_RUN:-1}" == "1" ]]; then
  echo
  echo "[DRY_RUN] pv.yaml"
  cat "$PV_YAML"
  echo
  echo "[DRY_RUN] pvc.yaml"
  cat "$PVC_YAML"
  echo
  echo "[DRY_RUN] pod.yaml"
  cat "$POD_YAML"
  exit 0
fi

kubectl get namespace "$NAMESPACE" >/dev/null 2>&1 || kubectl create namespace "$NAMESPACE"

kubectl -n "$NAMESPACE" get serviceaccount "$KSA_NAME" >/dev/null 2>&1 ||   kubectl -n "$NAMESPACE" create serviceaccount "$KSA_NAME"

kubectl -n "$NAMESPACE" annotate serviceaccount "$KSA_NAME"   iam.gke.io/gcp-service-account="$RUNTIME_GSA"   --overwrite

kubectl apply -f "$PV_YAML"
kubectl apply -f "$PVC_YAML"

echo "[INFO] PVC status"
kubectl -n "$NAMESPACE" get pvc "$PVC_NAME" -o wide

kubectl apply -f "$POD_YAML"

echo "[INFO] Waiting for Pod completion: $POD_NAME"
set +e
kubectl wait -n "$NAMESPACE"   --for=jsonpath='{.status.phase}'=Succeeded   "pod/$POD_NAME"   --timeout=3600s
WAIT_RC=$?
set -e

echo
echo "================ POD LOG ================"
kubectl -n "$NAMESPACE" logs "$POD_NAME" || true
echo "========================================="

if [[ $WAIT_RC -ne 0 ]]; then
  echo "[ERROR] Pod did not reach Succeeded."
  kubectl -n "$NAMESPACE" get pod "$POD_NAME" -o wide || true
  kubectl -n "$NAMESPACE" describe pod "$POD_NAME" || true
  exit "$WAIT_RC"
fi

kubectl -n "$NAMESPACE" delete pod "$POD_NAME" --ignore-not-found=true
rm -rf "$TMP_DIR"

echo "[SUCCESS] $PROGRAM_ID"
