#!/usr/bin/env bash
set -euo pipefail

# L2Comm03 - GKE Autopilot common client
# - Uses the private GKE kubeconfig on infra-son01
# - Creates/reuses a static NFS PV/PVC
# - Creates a batch Job (batch/v1) and mounts the Git-managed NFS share read-only
#
# Workflows / Cloud Scheduler is NOT used. This client talks to the GKE API
# directly: run-gke.sh -> client_gke -> GKE Job -> image pull -> python -> BigQuery

export KUBECONFIG="${KUBECONFIG:-$HOME/.kube/config_new-autopilot}"

PROGRAM_ID=""
DOCKER_IMAGE=""
GPU="0"
CPU="1"
MEM_GB="4"
SHELL_COMMAND=""
NAMESPACE="l2comm-batch"
KSA_NAME="ksa-l2comm-batch"
RUNTIME_GSA="sa-l2comm-gke@gcp-prod-edp-edge-509423.iam.gserviceaccount.com"

# Batch 대상 BigQuery (Pod 환경변수로 전달)
TARGET_PROJECT="${TARGET_PROJECT:-pjt-c-admin}"
# Cloud Logging 조회 대상(클러스터가 있는 프로젝트)
LOG_PROJECT="${LOG_PROJECT:-gcp-prod-edp-edge-509423}"
TARGET_DATASET="${TARGET_DATASET:-dlk_sample}"
TARGET_TABLE="${TARGET_TABLE:-gcp_region_inventory}"

# By default the current VM is used as the PoC NFS server.
NFS_SERVER="${NFS_SERVER:-$(hostname -I 2>/dev/null | awk '{print $1}')}"
NFS_PATH="${NFS_PATH:-/}"
PV_NAME="${PV_NAME:-l2comm-git-nfs-pv}"
PVC_NAME="${PVC_NAME:-l2comm-git-nfs-pvc}"
POD_MOUNT_PATH="${POD_MOUNT_PATH:-/mnt/l2comm}"
PV_SIZE="${PV_SIZE:-20Gi}"

usage() {
  cat <<'USAGE'
Usage:
  client_gke \
    --program-id PROGRAM_ID \
    --docker-image IMAGE_URI \
    --gpu 0 \
    --cpu 4 \
    --mem-gb 16 \
    --shell-command "cd /mnt/l2comm/python && python bq_sample.py" \
    [--namespace l2comm-batch] \
    [--nfs-server 172.x.x.x] \
    [--nfs-path /]

Creates a batch/v1 Job on GKE Autopilot. Workflows / Cloud Scheduler are not used.

Environment:
  KUBECONFIG      default: $HOME/.kube/config_new-autopilot
  DRY_RUN=1       create/print manifests only; do not kubectl apply (default)
  DRY_RUN=0       actually submit the Job
  PV_NAME         default: l2comm-git-nfs-pv
  PVC_NAME        default: l2comm-git-nfs-pvc
  POD_MOUNT_PATH  default: /mnt/l2comm
  PV_SIZE         default: 20Gi
  BACKOFF_LIMIT   default: 1
  TTL_SECONDS     default: 600    (ttlSecondsAfterFinished)
  JOB_TIMEOUT     default: 3600   (kubectl wait timeout, seconds)
  KEEP_JOB=1      keep the Job after completion (default: delete)
  TARGET_PROJECT  default: pjt-c-admin
  TARGET_DATASET  default: dlk_sample
  TARGET_TABLE    default: gcp_region_inventory
  LOG_PROJECT     default: gcp-prod-edp-edge-509423 (Cloud Logging 폴백 조회 대상)
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --program-id) PROGRAM_ID="$2"; shift 2 ;;
    --docker-image) DOCKER_IMAGE="$2"; shift 2 ;;
    --gpu) GPU="$2"; shift 2 ;;
    --cpu) CPU="$2"; shift 2 ;;
    --mem-gb) MEM_GB="$2"; shift 2 ;;
    --shell-command) SHELL_COMMAND="$2"; shift 2 ;;
    --namespace) NAMESPACE="$2"; shift 2 ;;
    --nfs-server) NFS_SERVER="$2"; shift 2 ;;
    --nfs-path) NFS_PATH="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "ERROR: unknown option: $1" >&2; usage; exit 1 ;;
  esac
done

[[ -n "$PROGRAM_ID" ]] || { echo "ERROR: --program-id is required" >&2; exit 1; }
[[ -n "$DOCKER_IMAGE" ]] || { echo "ERROR: --docker-image is required" >&2; exit 1; }
[[ -n "$SHELL_COMMAND" ]] || { echo "ERROR: --shell-command is required" >&2; exit 1; }
[[ -n "$NFS_SERVER" ]] || { echo "ERROR: NFS server IP could not be detected. Use --nfs-server." >&2; exit 1; }

JOB_BASE="$(echo "$PROGRAM_ID" | tr '[:upper:]' '[:lower:]' | tr '_. ' '---' | tr -cd 'a-z0-9-')"
JOB_BASE="${JOB_BASE:0:40}"
JOB_NAME="${JOB_BASE}-$(date +%Y%m%d%H%M%S)"
TMP_DIR="/tmp/${JOB_NAME}"
PV_YAML="${TMP_DIR}/pv.yaml"
PVC_YAML="${TMP_DIR}/pvc.yaml"
JOB_YAML="${TMP_DIR}/job.yaml"
mkdir -p "$TMP_DIR"

# Job 설정
BACKOFF_LIMIT="${BACKOFF_LIMIT:-1}"
TTL_SECONDS="${TTL_SECONDS:-600}"
JOB_TIMEOUT="${JOB_TIMEOUT:-3600}"

cat > "$PV_YAML" <<YAML
apiVersion: v1
kind: PersistentVolume
metadata:
  name: ${PV_NAME}
spec:
  capacity:
    storage: ${PV_SIZE}
  accessModes:
    - ReadOnlyMany
  persistentVolumeReclaimPolicy: Retain
  storageClassName: ""
  mountOptions:
    - vers=4.1
  nfs:
    server: ${NFS_SERVER}
    path: ${NFS_PATH}
    readOnly: true
YAML

cat > "$PVC_YAML" <<YAML
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: ${PVC_NAME}
  namespace: ${NAMESPACE}
spec:
  accessModes:
    - ReadOnlyMany
  storageClassName: ""
  volumeName: ${PV_NAME}
  resources:
    requests:
      storage: ${PV_SIZE}
YAML

cat > "$JOB_YAML" <<YAML
apiVersion: batch/v1
kind: Job
metadata:
  name: ${JOB_NAME}
  namespace: ${NAMESPACE}
  labels:
    app: l2comm-batch
    program-id: ${JOB_BASE}
spec:
  backoffLimit: ${BACKOFF_LIMIT}
  ttlSecondsAfterFinished: ${TTL_SECONDS}
  template:
    metadata:
      labels:
        app: l2comm-batch
        program-id: ${JOB_BASE}
    spec:
      restartPolicy: Never
      serviceAccountName: ${KSA_NAME}
      containers:
        - name: batch
          image: ${DOCKER_IMAGE}
          imagePullPolicy: IfNotPresent
          command: ["/bin/bash", "-c"]
          args:
            - |
              set -e
              ${SHELL_COMMAND}
          env:
            - name: PROGRAM_ID
              value: "${PROGRAM_ID}"
            - name: TARGET_PROJECT
              value: "${TARGET_PROJECT}"
            - name: TARGET_DATASET
              value: "${TARGET_DATASET}"
            - name: TARGET_TABLE
              value: "${TARGET_TABLE}"
          resources:
            requests:
              cpu: "${CPU}"
              memory: "${MEM_GB}Gi"
            limits:
              cpu: "${CPU}"
              memory: "${MEM_GB}Gi"
          volumeMounts:
            - name: git-nfs
              mountPath: ${POD_MOUNT_PATH}
              readOnly: true
      volumes:
        - name: git-nfs
          persistentVolumeClaim:
            claimName: ${PVC_NAME}
YAML

if [[ "$GPU" != "0" ]]; then
  python3 -I - "$JOB_YAML" "$GPU" <<'PY'
import sys
from pathlib import Path

path = Path(sys.argv[1])
gpu = sys.argv[2]
text = path.read_text()
needle = '''            limits:
              cpu: "'''
replacement = '''            limits:
              nvidia.com/gpu: "''' + gpu + '''"
              cpu: "'''
if needle not in text:
    raise SystemExit("GPU insertion point not found")
path.write_text(text.replace(needle, replacement, 1))
PY
fi

echo "============================================================"
echo "L2Comm03 GKE batch"
echo "============================================================"
echo "KUBECONFIG    : $KUBECONFIG"
echo "NAMESPACE     : $NAMESPACE"
echo "PROGRAM_ID    : $PROGRAM_ID"
echo "JOB_NAME      : $JOB_NAME"
echo "IMAGE         : $DOCKER_IMAGE"
echo "CPU/MEM/GPU   : $CPU / ${MEM_GB}Gi / $GPU"
echo "NFS_SERVER    : $NFS_SERVER"
echo "NFS_PATH      : $NFS_PATH"
echo "PV/PVC        : $PV_NAME / $PVC_NAME"
echo "POD_MOUNT     : $POD_MOUNT_PATH"
echo "COMMAND       : $SHELL_COMMAND"
echo "BQ TARGET     : ${TARGET_PROJECT}.${TARGET_DATASET}.${TARGET_TABLE}"
echo "MANIFEST_DIR  : $TMP_DIR"
echo "============================================================"

if [[ "${DRY_RUN:-1}" == "1" ]]; then
  echo
  echo "[DRY_RUN] pv.yaml"
  cat "$PV_YAML"
  echo
  echo "[DRY_RUN] pvc.yaml"
  cat "$PVC_YAML"
  echo
  echo "[DRY_RUN] job.yaml"
  cat "$JOB_YAML"
  exit 0
fi

kubectl get namespace "$NAMESPACE" >/dev/null 2>&1 || kubectl create namespace "$NAMESPACE"

kubectl -n "$NAMESPACE" get serviceaccount "$KSA_NAME" >/dev/null 2>&1 ||   kubectl -n "$NAMESPACE" create serviceaccount "$KSA_NAME"

kubectl -n "$NAMESPACE" annotate serviceaccount "$KSA_NAME"   iam.gke.io/gcp-service-account="$RUNTIME_GSA"   --overwrite

kubectl apply -f "$PV_YAML"
kubectl apply -f "$PVC_YAML"

echo "[INFO] PVC status"
kubectl -n "$NAMESPACE" get pvc "$PVC_NAME" -o wide

kubectl apply -f "$JOB_YAML"

echo "[INFO] Waiting for Job completion: $JOB_NAME (timeout ${JOB_TIMEOUT}s)"
set +e
kubectl wait -n "$NAMESPACE" --for=condition=complete \
  "job/$JOB_NAME" --timeout="${JOB_TIMEOUT}s"
WAIT_RC=$?
set -e

echo
echo "================ JOB LOG ================"
# Private cluster 에서 konnectivity 가 연결되지 않으면 kubectl logs 가
#   Error from server: ... "No agent available"
# 로 실패합니다. 그 경우 Cloud Logging 에서 같은 로그를 받아옵니다.
set +e
LOG_OUT="$(kubectl -n "$NAMESPACE" logs "job/$JOB_NAME" --all-containers --tail=-1 2>&1)"
LOG_RC=$?
set -e

if [[ ${LOG_RC} -eq 0 && -n "${LOG_OUT}" ]]; then
  printf '%s\n' "${LOG_OUT}"
else
  echo "[WARN] kubectl logs 실패 -> Cloud Logging 으로 조회합니다."
  [[ -n "${LOG_OUT}" ]] && echo "       사유: $(head -1 <<<"${LOG_OUT}")"
  echo
  gcloud logging read \
    "resource.type=\"k8s_container\"
     resource.labels.namespace_name=\"${NAMESPACE}\"
     labels.\"k8s-pod/job-name\"=\"${JOB_NAME}\"" \
    --project="${LOG_PROJECT}" \
    --limit=200 --freshness=1h \
    --format="value(textPayload)" --order=asc 2>/dev/null \
    || echo "[WARN] Cloud Logging 조회도 실패했습니다. 아래로 직접 확인하십시오."
  echo
  echo "  gcloud logging read 'resource.labels.namespace_name=\"${NAMESPACE}\"' \\"
  echo "    --project=${LOG_PROJECT} --limit=50 --freshness=1h"
fi
echo "========================================="

if [[ $WAIT_RC -ne 0 ]]; then
  echo "[ERROR] Job did not complete successfully."
  kubectl -n "$NAMESPACE" get job "$JOB_NAME" -o wide || true
  kubectl -n "$NAMESPACE" describe job "$JOB_NAME" || true
  kubectl -n "$NAMESPACE" get pods -l "job-name=$JOB_NAME" -o wide || true
  exit "$WAIT_RC"
fi

echo "[INFO] Job status"
kubectl -n "$NAMESPACE" get job "$JOB_NAME" -o wide || true

# ttlSecondsAfterFinished 로 자동 정리되지만, 즉시 회수하려면 KEEP_JOB=0
if [[ "${KEEP_JOB:-0}" != "1" ]]; then
  kubectl -n "$NAMESPACE" delete job "$JOB_NAME" --ignore-not-found=true
fi
rm -rf "$TMP_DIR"

echo "[SUCCESS] $PROGRAM_ID"
